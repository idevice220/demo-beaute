// L'Écrin (démo NEX-WEB) — schéma Prisma, PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Setting {
  tenant    String   @default("demo")
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@id([tenant, key])
}

/// Horodatages globaux (dernier nettoyage des copies expirées)
model Meta {
  id        Int      @id
  lastSweep DateTime @default(now())
}

/// Une copie de la démo : "demo" = version d'origine (lecture seule), sinon la copie privée d'un visiteur
model Tenant {
  id          String   @id
  seedVersion String
  createdAt   DateTime @default(now())
  lastSeen    DateTime @default(now())
}

model Media {
  tenant    String   @default("demo")
  id        String   @id @default(cuid())
  name      String
  mime      String
  size      Int
  width     Int
  height    Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([tenant])
}

model Category {
  tenant  String  @default("demo")
  id      Int     @id @default(autoincrement())
  name    String
  image   String
  blurb   String
  order   Int     @default(0)
  visible Boolean @default(true)
  soins   Soin[]

  @@index([tenant])
}

model Soin {
  tenant     String   @default("demo")
  id         Int      @id @default(autoincrement())
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  desc       String   @default("")
  min        Int
  price      Float
  signature  Boolean  @default(false)
  isNew      Boolean  @default(false)
  order      Int      @default(0)
  visible    Boolean  @default(true)

  @@index([categoryId])
  @@index([tenant])
}

model Rituel {
  tenant  String   @default("demo")
  id      Int      @id @default(autoincrement())
  name    String
  sub     String
  min     Int
  price   Float
  was     Float?
  items   String[]
  image   String
  order   Int      @default(0)
  visible Boolean  @default(true)

  @@index([tenant])
}

model TeamMember {
  tenant  String  @default("demo")
  id      Int     @id @default(autoincrement())
  name    String
  role    String
  spec    String
  image   String
  years   Int
  order   Int     @default(0)
  visible Boolean @default(true)

  @@index([tenant])
}

model GalleryItem {
  tenant  String  @default("demo")
  id      Int     @id @default(autoincrement())
  src     String
  alt     String
  tall    Boolean @default(false)
  order   Int     @default(0)
  visible Boolean @default(true)

  @@index([tenant])
}

model Review {
  tenant  String  @default("demo")
  id      Int     @id @default(autoincrement())
  name    String
  date    String
  text    String
  soin    String
  rating  Int     @default(5)
  order   Int     @default(0)
  visible Boolean @default(true)

  @@index([tenant])
}

model FaqItem {
  tenant  String  @default("demo")
  id      Int     @id @default(autoincrement())
  q       String
  a       String
  order   Int     @default(0)
  visible Boolean @default(true)

  @@index([tenant])
}

/// Rendez-vous pris en ligne
model Booking {
  tenant    String   @default("demo")
  id        Int      @id @default(autoincrement())
  item      String
  staff     String
  date      String // AAAA-MM-JJ
  time      String // HH:MM
  duration  Int
  price     Float
  name      String
  email     String
  phone     String
  note      String?
  status    String   @default("confirmed") // confirmed | done | cancelled
  createdAt DateTime @default(now())

  @@index([date])
  @@index([tenant])
}

/// Commandes de cartes cadeaux
model GiftOrder {
  tenant    String   @default("demo")
  id        Int      @id @default(autoincrement())
  amount    Int
  to        String
  from      String
  message   String?
  mode      String // email | ecrin
  status    String   @default("new") // new | sent
  createdAt DateTime @default(now())

  @@index([tenant])
}

/// Inscrits à la lettre d'information
model Subscriber {
  tenant    String   @default("demo")
  id        Int      @id @default(autoincrement())
  email     String
  createdAt DateTime @default(now())

  @@unique([tenant, email])
  @@index([tenant])
}
